{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scp-survivor-accounts",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"FIREBASE_PROJECT_ID": "scp-survivor"},
  "durable_objects": {"bindings": [{"name": "ACCOUNTS", "class_name": "AccountsObject"}]},
  "migrations": [{"tag": "p05-v1", "new_sqlite_classes": ["AccountsObject"]}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
