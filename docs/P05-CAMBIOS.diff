+        if page.evaluate('() => ('+expression+')'):
+            return
+        page.wait_for_timeout(75)
+    raise AssertionError('Timeout: '+expression+'; '+page.locator('#account-notice').inner_text())
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
